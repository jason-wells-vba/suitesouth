# Copy to .env.local for local development.
# In production these four live in the Vercel project's Environment Variables.

# Injected automatically by the Neon integration on Vercel.
DATABASE_URL=

# The single shared password you and your wife type to sign in.
APP_PASSWORD=

# Signs the session cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Bearer key for the REST API (/api/v1) and the MCP server (/api/mcp).
# Separate from APP_PASSWORD so either can be rotated alone. Leave empty to
# keep both switched off. Generate one the same way as SESSION_SECRET.
API_KEY=
